# Copy this file to .env and fill in values.
# Vite only exposes variables prefixed with VITE_ to the browser.

# --- App ---
VITE_APP_NAME="KULT Creator Studio"

# --- API ---
# Local dev: keep /api (vite.config.ts proxies to http://127.0.0.1:3001)
# Production: set full URL, e.g. https://your-api.example.com/api
VITE_API_URL=/api

# --- Thumbnails CDN ---
VITE_THUMBNAILS_BASE=https://creator-studio.sfo3.digitaloceanspaces.com/thumbnails

# --- Privy auth (must use VITE_ prefix) ---
VITE_PRIVY_APP_ID=
# Optional — only if your Privy dashboard shows a Client ID
# VITE_PRIVY_CLIENT_ID=

# --- Optional: link back to main Kult browser ---
# VITE_BROWSER_URL=https://kult-browser-rust-l2lwg.ondigitalocean.app/

# --- TON paid generations ---
VITE_TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC
VITE_TON_TREASURY_WALLET=

# --- Optional: legacy 0G payments (defaults work if omitted) ---
# VITE_ZERO_G_MAINNET_CHAIN_ID=16661
# VITE_ZERO_G_MAINNET_RPC_URL=https://evmrpc.0g.ai
# VITE_ZERO_G_TREASURY_WALLET=

# --- Local dev notes ---
# 1. Start backend on port 3001 (Creator Studio API)
# 2. npm run dev
# 3. Open http://localhost:5173/
#
# Backend/shared API env names now use:
# VITE_PRIVY_APP_ID
# VITE_PRIVY_VERIFICATION_KEY
